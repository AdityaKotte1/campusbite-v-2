NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SECRET_ENCRYPTION_KEY=your-32-byte-hex-key
KIOSK_ENCRYPTION_KEY=your-32-byte-hex-key
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
# The student app's public URL — shown in Settings as the food-payment webhook target.
NEXT_PUBLIC_STUDENT_APP_URL=http://localhost:3000

# Platform Razorpay account — used ONLY for INSTITUTE SUBSCRIPTION payments
# (institute pays CampusBite). Separate from per-canteen food-payment keys.
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret for the subscription webhook (platform account). Must match the
# secret configured in the Razorpay dashboard webhook pointing at
# /api/v1/admin/subscriptions/webhook
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Secret for the daily subscription-expiry cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-random-string
