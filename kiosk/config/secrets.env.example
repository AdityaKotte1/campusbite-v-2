# MunchAdda Kiosk Secrets
# Copy to /etc/munchadda-kiosk/secrets.env (NOT inside the app directory)
# Permissions: sudo chmod 600 /etc/munchadda-kiosk/secrets.env
#              sudo chown root:root /etc/munchadda-kiosk/secrets.env

# Kiosk API key — get from admin panel → Kiosks → Register (shown ONCE)
MUNCHADDA_API_KEY=replace-with-your-api-key-from-admin-panel

# SQLite encryption key — generate with: openssl rand -hex 32
# Must be the same key on every boot for the same kiosk
DB_ENCRYPTION_KEY=replace-with-32-byte-hex-key
